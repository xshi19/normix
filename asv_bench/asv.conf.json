{
    // airspeed velocity config for the curated trend suite.
    // Paths are relative to cwd — run asv from this directory (`asv_bench/`).
    // Plan: ../dev-notes/plans/asv_benchmarking.md
    "version": 1,
    "project": "normix",
    "project_url": "https://xshi19.github.io/normix/",
    "repo": "..",
    "dvcs": "git",
    "branches": ["master"],
    "show_commit_url": "https://github.com/xshi19/normix/commit/",

    "environment_type": "uv",
    "pythons": ["3.12"],
    "benchmark_dir": "benchmarks",
    "env_dir": ".asv/env",
    "results_dir": "results",
    "html_dir": ".asv/html",
    "build_cache_size": 8,
    "install_timeout": 900.0,
    "default_benchmark_timeout": 180.0,
    "launch_method": "spawn",

    // PEP 517: one project wheel in the cache. `pip wheel` without
    // --no-deps dumps every dependency wheel here and ASV cannot pick
    // `{wheel_file}`.
    "build_command": [
        "python -m pip install build",
        "python -m build --wheel -o {build_cache_dir} {build_dir}"
    ],

    // Default ASV install is `{wheel_file} --force-reinstall`. We add the
    // cuda12 extra and, on Linux, `jax[cuda12]==0.9.1` so the plugin
    // lands (see `_asv_install.py`). env_nobuild does not rebuild: cpu
    // and cuda series share that install.
    "install_command": [
        "in-dir={env_dir} python {conf_dir}/_asv_install.py {wheel_file}"
    ],

    "matrix": {
        // Single-valued pin, lockstep with [tool.uv] constraint-dependencies.
        // Not a version-comparison matrix. ASV's uv plugin pip-installs and
        // does not read uv.lock.
        "req": {
            "jaxlib": ["0.9.1"],
            "jax": ["0.9.1"]
        },
        // Device axis: same install, two runtime series. Non-linux has
        // no jax[cuda12] wheels; drop the cuda series there.
        "env_nobuild": {
            "JAX_PLATFORMS": ["cpu", "cuda"],
            "XLA_PYTHON_CLIENT_PREALLOCATE": ["false"]
        }
    },

    "exclude": [
        {
            "sys_platform": "(?!linux).*",
            "env_nobuild": {"JAX_PLATFORMS": "cuda"}
        }
    ]
}
